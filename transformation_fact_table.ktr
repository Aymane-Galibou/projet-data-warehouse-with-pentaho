    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
var order_purchase_date = null;
var date_id = null;

if (order_purchase_timestamp != null &amp;&amp; order_purchase_timestamp != "") {
    var parts = order_purchase_timestamp.split(" ");
    var dateParts = parts[0].split("-"); // [2017, 10, 02]
    var timeParts = parts[1].split(":"); // [10, 56, 33]
    
    var year = parseInt(dateParts[0], 10);
    var month = parseInt(dateParts[1], 10) - 1; 
    var day = parseInt(dateParts[2], 10);
    
    var hour = parseInt(timeParts[0], 10);
    var minute = parseInt(timeParts[1], 10);
    var second = parseInt(timeParts[2], 10);
    
    order_purchase_date = new Date(year, month, day, hour, minute, second);
    
    // Clean and simple YYYYMMDD integer generation
    var realMonth = month + 1;
    date_id = (year * 10000) + (realMonth * 100) + day;
}</jsScript_script>
      </jsScript>
    </jsScripts>
