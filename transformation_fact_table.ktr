  <step>
    <name>calculating date based on two columns</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Parse the date components safely using standard var
var parts = shipping_limit_date.split('/');

var month = parseInt(parts[0], 10) - 1;
var day = parseInt(parts[1], 10);
var year = parseInt(parts[2], 10);

if (year &lt; 100) {
    year += 2000;
}

var dateLimitOfShipping = new Date(year, month, day);</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>dateLimitOfShipping</name>
        <rename>date_limit_of_shipping</rename>
        <type>Date</type>
        <length>-1</length>
